@echo off
cd /d "%~dp0"
echo === CAI DAT LAN DAU ===
where python >nul 2>nul || (echo Chua cai Python 3.10/3.11 hoac chua Add to PATH & pause & exit /b 1)
if not exist venv (python -m venv venv)
call venv\Scripts\activate.bat
python -m pip install --upgrade pip
pip install flask opencv-python mysql-connector-python requests numpy
pip install dlib-bin
pip install face_recognition --no-deps
pip install face_recognition_models Click Pillow "setuptools<81"
python -c "import face_recognition, cv2, flask, mysql.connector; print('OK - cai dat xong')"
pause
